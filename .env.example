# Copy to .env and fill in. Never commit .env.
# Required only for stages that call the model. Stages 1-7 -- partition,
# template, chunks, evidence -- run with no key at all.
#
# Set whichever provider you have. The client picks the one whose key is
# present; force it with SOW_PROVIDER=anthropic|openai.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Backend: "live" calls the API, "mock" replays tests/fixtures/golden_run
# (no key needed, used by the test suite).
SOW_LLM=live

# Optional overrides.
# SOW_PROVIDER=anthropic
# SOW_MODEL=claude-opus-5

# NOTE: values here OVERRIDE an exported shell variable of the same name, and
# the override is announced on stderr. A stale exported key cannot silently
# shadow the one you just pasted here.
