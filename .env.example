# Copy to .env and fill in. Never commit .env.
# Required only for stages that call the model (checkpoint 3 onward).
# Stages 1-7 -- partition, template, chunks, evidence -- run with no key at all.
OPENAI_API_KEY=sk-...

# Backend: "live" calls the API, "mock" replays tests/fixtures/golden_run
# (no key needed, used by the test suite).
SOW_LLM=live

# Optional model override. Defaults to gpt-5.4.
# SOW_MODEL=gpt-5.4-mini

# NOTE: an exported shell variable takes precedence over this file.
# If a key here seems ignored, check for an exported OPENAI_API_KEY.
